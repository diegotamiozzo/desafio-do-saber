# GROQ_API_KEY: Required for Groq AI generation (model openai/gpt-oss-20b)
GROQ_API_KEY=

# GEMINI_API_KEY: Optional fallback
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Test credentials for Login page
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=admin

# Optional Render backend URL when hosted on Netlify (e.g. https://meu-backend.onrender.com)
VITE_API_BASE_URL=
